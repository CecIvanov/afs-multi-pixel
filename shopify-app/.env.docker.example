# Copy to .env.docker on the VPS. Values from the app in the Dev Dashboard (Settings → Credentials).
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
# Must match application_url in shopify.app.toml.
SHOPIFY_APP_URL=https://multi-pixel-test-app.adfeedstudio.com
SCOPES=read_markets,write_pixels,read_customer_events
