# Copy to .env.docker. Values from the app in the Shopify Dev Dashboard (Settings → Credentials).
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
# Public HTTPS URL that reaches this container; must match application_url in shopify.app.toml.
SHOPIFY_APP_URL=https://multi-pixel.example.com
SCOPES=read_markets,write_pixels,read_customer_events
