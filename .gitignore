# Secrets — only the .example twins are committed
.credentials.*
!.credentials.example
!.credentials.*.example

# Per-stack env files. .env.uat and .env.production hold only non-secret settings
# and are committed; dev's .env.dev stays local (copied from .env.example).
# Secrets are in .credentials.<stack>, which is never committed.
.env
.env.*
!.env.example
!.env.*.example
!.env.uat
!.env.production

# Node
node_modules/
shopify/build/
shopify/.react-router/
shopify/.shopify/

# Python
.venv/
__pycache__/
*.pyc
.pytest_cache/

# Build / test artifacts
dist/
coverage/
test-results/
playwright-report/
e2e-ui/storageState.json

# OS / editor
.DS_Store
*.log
