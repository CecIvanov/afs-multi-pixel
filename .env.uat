# ---------------------------------------------------------------------------
# UAT stack: NON-SECRET settings, committed. The UAT App is a SEPARATE Shopify app
# (a custom app: custom distribution, no billing), database and backend stack. Secrets live only on the VPS
# in .credentials.uat (never committed; start from .credentials.example).
# Ports differ from dev/production so the stacks can share one host.
# ---------------------------------------------------------------------------

APP_ENV=uat

# --- Database: the VPS's own Postgres (database/role afsmultipixel_uat) -----------
# The containers reach the host's Postgres at host.docker.internal (docker-compose
# maps it to the host gateway). Postgres must accept that connection: listen on the
# Docker bridge and allow it in pg_hba.conf (scripts/db/allow-docker-access.sh).
DATABASE_HOST=host.docker.internal
DATABASE_PORT=5432
# The same Postgres as seen from a shell on the VPS (scripts/db/setup.sh, backup.sh).
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=5

# --- Published ports (127.0.0.1 only; Caddy proxies the UI port) ---------------
API_PORT=8010
UI_PORT=3010
WORKER_METRICS_PORT=9110
API_WORKERS=1

# --- Shopify: the UAT App (its client secret is in .credentials.uat) ----------
# The client ID is public; it must match client_id in shopify.app.uat.toml.
SHOPIFY_API_KEY=cbf79027737c8bcbd7657e9af8328383
# The public URL Caddy serves. Also the base of the storefront's Relay endpoint
# (<SHOPIFY_APP_URL>/api/events), so it must match shopify.app.uat.toml.
SHOPIFY_APP_URL=https://multi-pixel-uat.adfeedstudio.com
SCOPES=read_markets,write_pixels,read_customer_events,read_orders

# --- Billing: none -------------------------------------------------------------
# The UAT App is a custom app (custom distribution): Shopify doesn't bill it. Every
# shop counts as subscribed, the Partner API is never called and the admin shows
# no Plan page. (Billing settings live only in .env.production.)
SHOPIFY_BILLING_MODE=disabled

LOG_LEVEL=info
