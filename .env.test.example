# Test env. run-tests-isolated.sh assembles TEST_DATABASE_URL from app.config.json
# (the <slug>_test database) + the ephemeral Postgres it starts, so you normally
# don't set it. For run-tests.sh against your own DB, set it here:
#   TEST_DATABASE_URL=postgresql://afsmultipixel_test@127.0.0.1:5433/afsmultipixel_test

APP_ENV=test
INTERNAL_API_KEY=dev-internal-key
# External services point at dead ports in tests so nothing calls out by accident.
REDIS_URL=redis://127.0.0.1:6399/0
