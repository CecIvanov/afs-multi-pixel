-- Creates or updates the application role and database for one environment.
-- Rendered by scripts/lib/db.sh (placeholders substituted with proper identifier
-- quoting) — do not run this template directly.
--
-- The same PostgreSQL database is shared by two migration histories that own
-- disjoint tables: Prisma (the Shopify OAuth `Session` table) and SQLAlchemy /
-- Alembic (everything else). This script only provisions the role, database and
-- privileges; the tables are created by `scripts/db/migrate.sh`.

DO $$
BEGIN
  IF NOT EXISTS (SELECT FROM pg_roles WHERE rolname = '{{DB_USER}}') THEN
    CREATE USER {{DB_USER_IDENT}} WITH PASSWORD '{{DB_PASSWORD}}';
  ELSE
    ALTER USER {{DB_USER_IDENT}} WITH PASSWORD '{{DB_PASSWORD}}';
  END IF;
END
$$;

SELECT format(
  'CREATE DATABASE %I OWNER %I ENCODING ''UTF8'' TEMPLATE template0',
  '{{DB_NAME}}', '{{DB_USER}}'
)
WHERE NOT EXISTS (SELECT FROM pg_database WHERE datname = '{{DB_NAME}}')
\gexec

REVOKE ALL ON DATABASE {{DB_NAME_IDENT}} FROM PUBLIC;
GRANT CONNECT ON DATABASE {{DB_NAME_IDENT}} TO {{DB_USER_IDENT}};

\connect {{DB_NAME_IDENT}}

-- Extensions used by the schema. gen_random_uuid() (pgcrypto) backs the UUID
-- primary keys; citext is handy for case-insensitive shop domains / emails.
CREATE EXTENSION IF NOT EXISTS "pgcrypto";
CREATE EXTENSION IF NOT EXISTS "citext";

GRANT ALL ON SCHEMA public TO {{DB_USER_IDENT}};
ALTER DEFAULT PRIVILEGES IN SCHEMA public
    GRANT SELECT, INSERT, UPDATE, DELETE ON TABLES TO {{DB_USER_IDENT}};
ALTER DEFAULT PRIVILEGES IN SCHEMA public
    GRANT USAGE, SELECT ON SEQUENCES TO {{DB_USER_IDENT}};
