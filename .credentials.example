# ---------------------------------------------------------------------------
# .credentials.<stack> — SECRETS for one environment. NEVER commit the real file.
#   cp .credentials.example .credentials.dev
#
# Sourced (set -a) before docker compose / the DB scripts so the ${VAR}
# references in .env.<stack> resolve. Keep every real value out of git.
# ---------------------------------------------------------------------------

# Database password for the app role (myapp_dev / myapp / ...).
DATABASE_PASSWORD=change-me-dev

# Shared secret guarding the Node BFF -> Python /internal boundary.
# MUST be a real secret in staging/production (never the dev default).
INTERNAL_API_KEY=dev-internal-key

# Shopify app credentials (from the Partner Dashboard).
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=

# Encryption at rest for Conversions API tokens and the Relay private key: 32 bytes as
# 64 hex characters or base64. One key per environment; losing it makes stored tokens
# unreadable. Generate with: openssl rand -hex 32
TOKEN_ENC_KEY=

# Partner API (only needed for managed-billing reconcile).
SHOPIFY_APP_GID=
SHOPIFY_PARTNER_ORG_ID=
SHOPIFY_PARTNER_ACCESS_TOKEN=
