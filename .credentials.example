# ---------------------------------------------------------------------------
# .credentials.<stack> — SECRETS for one environment. NEVER committed (.gitignore).
#   dev:         cp .credentials.example .credentials.dev            (your machine)
#   uat:         cp .credentials.example .credentials.uat            (on the VPS)
#   production:  cp .credentials.example .credentials.production     (on the VPS)
#   then: chmod 600 .credentials.<stack>
#
# Edit the uat/production files directly on the VPS. Non-secret settings go in the
# committed .env.uat / .env.production instead. Sourced (set -a) before docker
# compose / the DB scripts so the ${VAR} references in .env.<stack> resolve.
# ---------------------------------------------------------------------------

# Database password for the app role (afsmultipixel_<stack>).
DATABASE_PASSWORD=change-me-dev

# Shared secret guarding the Node BFF -> Python /internal boundary.
# MUST be a real secret in staging/production (never the dev default).
INTERNAL_API_KEY=dev-internal-key

# Shopify app credentials of THIS stack's app (Partner Dashboard → the app →
# Client credentials): the UAT App and the Production App each have their own.
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=

# Encryption at rest for Conversions API tokens and the Relay private key: 32 bytes as
# 64 hex characters or base64. One key per environment; losing it makes stored tokens
# unreadable. Generate with: openssl rand -hex 32
TOKEN_ENC_KEY=

# Partner API access token (Partner Dashboard → Settings → Partner API clients),
# with access to the app's billing: reads each shop's subscription to the plan
# (Shopify App Pricing). The app GID and org ID are not secret: .env.<stack>.
SHOPIFY_PARTNER_ACCESS_TOKEN=
