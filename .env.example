# ---------------------------------------------------------------------------
# .env.<stack> — NON-SECRET infrastructure config for the DEV environment.
#   cp .env.example .env.dev
# UAT and PRODUCTION are SEPARATE environments (separate Shopify app, database,
# and backend): see the committed .env.uat and .env.production (distinct ports).
#
# App identity (name, handle, plans, scopes) does NOT live here — it lives in the
# single config file: app.config.json. This file holds only infra wiring.
# Secrets live in .credentials.<stack> and are referenced as ${VAR} below.
# ---------------------------------------------------------------------------

APP_ENV=dev

# --- Database ---------------------------------------------------------------
# The database NAME and USER are derived from app.config.json (afsmultipixel_dev, etc.).
# Set only the connection endpoint + password reference here. Inside Docker the
# services reach Postgres at host `postgres`; host-run scripts use 127.0.0.1.
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=5

# --- Redis (Celery broker + caches) -----------------------------------------
# Inside Docker the services use redis://redis:6379/0 (set in compose).
REDIS_URL=redis://127.0.0.1:6379/1

# --- Published ports (bound to 127.0.0.1 by compose) ------------------------
API_PORT=8000
UI_PORT=3000
WORKER_METRICS_PORT=9100
API_WORKERS=1

# --- Toggles ----------------------------------------------------------------
BILLING_ENFORCEMENT_ENABLED=true

# --- Shopify ----------------------------------------------------------------
# The dev app's client ID (public; matches client_id in shopify.app.toml). Its
# client secret (SHOPIFY_API_SECRET) is in .credentials.dev.
SHOPIFY_API_KEY=
# Scopes + API version are in app.config.json; SCOPES here must match it.
SHOPIFY_APP_URL=https://localhost:3000
SCOPES=read_markets,write_pixels,read_customer_events,read_orders
# Billing: managed | api | disabled. SHOPIFY_APP_HANDLE defaults to app.config.json's slug/handle.
SHOPIFY_BILLING_MODE=managed
# Shopify App Pricing (spec §5): plans are in app.config.json billing.plans; the
# Partner API reports a shop's subscription (token in .credentials.dev).
SHOPIFY_APP_GID=
SHOPIFY_PARTNER_ORG_ID=
SHOPIFY_PARTNER_API_VERSION=2026-07
# SHOPIFY_APP_HANDLE=afs-multi-pixel

# --- Logging / metrics ------------------------------------------------------
LOG_LEVEL=info
# SENTRY_DSN=            # optional; unset = error tracking disabled
