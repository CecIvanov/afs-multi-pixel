# ---------------------------------------------------------------------------
# PRODUCTION stack: NON-SECRET settings, committed. The Production App is a
# SEPARATE Shopify app (public App Store listing), database and backend stack.
# Secrets live only on the VPS in .credentials.production (never committed; start
# from .credentials.example). Ports differ from dev/uat so the stacks can share
# one host.
# ---------------------------------------------------------------------------

APP_ENV=production

# --- Database (afsmultipixel_production, derived from app.config.json slug) ---
# To use an existing Postgres server instead of the container, set POSTGRES_HOST
# and adjust docker-compose.production.yml.
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5452
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=10

REDIS_URL=redis://127.0.0.1:6379/3

# --- Published ports (127.0.0.1 only; Caddy proxies the UI port) ---------------
API_PORT=8020
UI_PORT=3020
WORKER_METRICS_PORT=9120
API_WORKERS=2

# --- Toggles -----------------------------------------------------------------
BILLING_ENFORCEMENT_ENABLED=true

# --- Shopify: the Production App (client ID and secret in .credentials.production)
# The public URL Caddy serves. Also the base of the storefront's Relay endpoint
# (<SHOPIFY_APP_URL>/api/events), so it must match shopify.app.production.toml.
SHOPIFY_APP_URL=https://multi-pixel-prd.adfeedstudio.com
# Must be the handle Shopify gives the Production App (shopify.app.production.toml
# after `npm run config:link:production`); the managed-pricing plan page uses it.
SHOPIFY_APP_HANDLE=afs-multi-pixel-production
SCOPES=read_markets,write_pixels,read_customer_events,read_orders

# --- Billing: Shopify App Pricing (managed pricing, spec §5) -------------------
# The plans (shopify-test, light, …) and their ranks are in app.config.json
# billing.plans, by their exact Partner Dashboard handles.
SHOPIFY_BILLING_MODE=managed
# REQUIRED for managed pricing. The Production App's GID (gid://shopify/App/<id>)
# and the Partner organization ID (the number in partners.shopify.com/<id>/…).
# The Partner API access token is a secret: SHOPIFY_PARTNER_ACCESS_TOKEN in
# .credentials.production.
SHOPIFY_APP_GID=
SHOPIFY_PARTNER_ORG_ID=
SHOPIFY_PARTNER_API_VERSION=2026-07

LOG_LEVEL=info
