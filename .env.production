# ---------------------------------------------------------------------------
# PRODUCTION stack: NON-SECRET settings, committed. The Production App is a
# SEPARATE Shopify app (public App Store listing), database and backend stack.
# Secrets live only on the VPS in .credentials.production (never committed; start
# from .credentials.example). Ports differ from dev/uat so the stacks can share
# one host.
# ---------------------------------------------------------------------------

APP_ENV=production

# --- Database: the VPS's own Postgres (database/role afsmultipixel) -----------
# The containers reach the host's Postgres at host.docker.internal (docker-compose
# maps it to the host gateway). Postgres must accept that connection: listen on the
# Docker bridge and allow it in pg_hba.conf (scripts/db/allow-docker-access.sh).
# Database name and role (the password is DATABASE_PASSWORD in .credentials.production).
DB_NAME=afsmultipixel
DB_USER=afsmultipixel
DATABASE_HOST=host.docker.internal
DATABASE_PORT=5432
# The same Postgres as seen from a shell on the VPS (scripts/db/setup.sh, backup.sh).
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=10

# --- Published ports (127.0.0.1 only) -----------------------------------------
# VPS Black also runs Blacklist COD on 3010/3020, 8010/8020, 9110/9120, so this
# app uses 31x0/81x0/92x0. Caddy (Caddy-black, host network) proxies the public
# URL to 127.0.0.1:UI_PORT: deploy/caddy/Caddyfile.snippet.
API_PORT=8120
UI_PORT=3120
WORKER_METRICS_PORT=9220
API_WORKERS=2

# --- Toggles -----------------------------------------------------------------
BILLING_ENFORCEMENT_ENABLED=true

# --- Shopify: the Production App (its client secret is in .credentials.production)
# The client ID is public; it must match client_id in shopify.app.production.toml.
SHOPIFY_API_KEY=4e22a50fb4b433f72347339801cf7e3f
# The public URL Caddy serves. Also the base of the storefront's Relay endpoint
# (<SHOPIFY_APP_URL>/api/events), so it must match shopify.app.production.toml.
SHOPIFY_APP_URL=https://multi-pixel-prd.adfeedstudio.com
# Must be the handle Shopify gives the Production App (shopify.app.production.toml
# after `npm run config:link:production`); the managed-pricing plan page uses it.
SHOPIFY_APP_HANDLE=afs-multi-pixel
SCOPES=read_markets,write_pixels,read_customer_events,read_orders

# --- Billing: Shopify App Pricing (managed pricing, spec §5) -------------------
# The plans (shopify-test, light, …) and their ranks are in app.config.json
# billing.plans, by their exact Partner Dashboard handles.
SHOPIFY_BILLING_MODE=managed
# REQUIRED for managed pricing. The Production App's GID (gid://shopify/App/<id>)
# and the Partner organization ID (the number in partners.shopify.com/<id>/…).
# The Partner API access token is a secret: SHOPIFY_PARTNER_ACCESS_TOKEN in
# .credentials.production.
SHOPIFY_APP_GID=gid://shopify/App/430700724225
SHOPIFY_PARTNER_ORG_ID=4865248
SHOPIFY_PARTNER_API_VERSION=2026-07

LOG_LEVEL=info
