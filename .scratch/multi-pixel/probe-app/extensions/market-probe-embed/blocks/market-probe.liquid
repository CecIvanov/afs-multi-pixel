{%- comment -%}
  Throwaway probe: exposes the Liquid-resolved Market to the web pixel,
  through a first-party cookie and a custom analytics event.
{%- endcomment -%}
<script>
  (function () {
    var probe = {
      marketId: {{ localization.market.id | json }},
      marketHandle: {{ localization.market.handle | json }},
      country: {{ localization.country.iso_code | json }},
      language: {{ localization.language.iso_code | json }},
      currency: {{ cart.currency.iso_code | json }},
      renderedAt: Date.now()
    };
    document.cookie = '_mp_market=' + probe.marketId + '; path=/; max-age=1800; SameSite=Lax';
    console.log('[market-probe-embed]', JSON.stringify(probe));
    if (window.Shopify && Shopify.analytics && Shopify.analytics.publish) {
      Shopify.analytics.publish('market_probe:market', probe);
    } else {
      console.log('[market-probe-embed] Shopify.analytics.publish not available yet');
    }
  })();
</script>

{% schema %}
{
  "name": "Market probe",
  "target": "head",
  "settings": []
}
{% endschema %}
