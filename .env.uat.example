# ---------------------------------------------------------------------------
# UAT environment — a SEPARATE Shopify app, database, and backend stack.
#   cp .env.uat.example .env.uat   (then fill .credentials.uat)
# Ports differ from dev/prd so all three stacks can run on one host at once.
# ---------------------------------------------------------------------------

APP_ENV=uat

# --- Database (afsmultipixel_uat, derived from app.config.json slug) -----------------
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5442
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=5

REDIS_URL=redis://127.0.0.1:6379/2

# --- Published ports (distinct from dev/prd) --------------------------------
API_PORT=8010
UI_PORT=3010
WORKER_METRICS_PORT=9110
API_WORKERS=1

# --- Toggles ----------------------------------------------------------------
# UAT runs with billing enforcement OFF so every plan gate is open for testing.
BILLING_ENFORCEMENT_ENABLED=false

# --- Shopify (the UAT app — separate client_id/secret in .credentials.uat) ---
SHOPIFY_APP_URL=https://uat.example.com
SHOPIFY_APP_HANDLE=afs-multi-pixel-uat
SCOPES=read_markets,write_pixels,read_customer_events,read_orders
# The UAT App is custom distribution: it can't charge, so it counts as subscribed.
SHOPIFY_BILLING_MODE=disabled

LOG_LEVEL=info
