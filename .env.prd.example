# ---------------------------------------------------------------------------
# PRODUCTION environment — a SEPARATE Shopify app, database, and backend stack.
#   cp .env.prd.example .env.prd   (then fill .credentials.prd)
# Ports differ from dev/uat so all three stacks can run on one host at once.
# ---------------------------------------------------------------------------

APP_ENV=prd

# --- Database (afsmultipixel_prd, derived from app.config.json slug) -----------------
# In real production you often externalize Postgres (host/managed DB) — set
# POSTGRES_HOST accordingly and adjust the compose prd overlay.
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5452
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=10

REDIS_URL=redis://127.0.0.1:6379/3

# --- Published ports (distinct from dev/uat) --------------------------------
API_PORT=8020
UI_PORT=3020
WORKER_METRICS_PORT=9120
API_WORKERS=2

# --- Toggles ----------------------------------------------------------------
BILLING_ENFORCEMENT_ENABLED=true

# --- Shopify (the PRODUCTION app — separate client_id/secret in .credentials.prd) ---
SHOPIFY_APP_URL=https://app.example.com
SHOPIFY_APP_HANDLE=afs-multi-pixel-prd
SCOPES=write_products
SHOPIFY_BILLING_MODE=managed

LOG_LEVEL=info
